# Shared experiment configuration.
# Read by bash (`source config.env`) and by Python (via `bash -c 'source config.env; env'`).
# Every value can be overridden from the environment, e.g. `TPCH_SFS="1" src/setup/setup.sh data`.

# --- PostgreSQL ---------------------------------------------------------------
PG_MAJOR=${PG_MAJOR:-18}
PG_PORT=${PG_PORT:-5444}            # non-default port: never collides with a distro cluster

# --- Locations ----------------------------------------------------------------
# Must be on a local disk: /home is NFS on the lab servers and must not hold data.
DATA_ROOT=${DATA_ROOT:-/srv/tpch}
PGDATA=${PGDATA:-$DATA_ROOT/pgdata}
PGSOCK=${PGSOCK:-$DATA_ROOT/run}     # unix socket dir; TCP is disabled
TBL_DIR=${TBL_DIR:-$DATA_ROOT/tbl}  # dbgen output: $TBL_DIR/sf<N>/*.tbl*
PGBIN=${PGBIN:-/usr/lib/postgresql/$PG_MAJOR/bin}

# --- TPC-H data ---------------------------------------------------------------
TPCH_SFS=${TPCH_SFS:-"1 10"}        # scale factors to generate and load (SF100 later, on sdb)
GEN_JOBS=${GEN_JOBS:-8}             # parallel dbgen chunks / COPY streams for SF > 1
DBGEN_REPO=${DBGEN_REPO:-https://github.com/gregrahn/tpch-kit}
DBGEN_COMMIT=${DBGEN_COMMIT:-852ad0a5ee31ebefeed884cea4188781dd9613a3}

# --- Measurement --------------------------------------------------------------
IO_DEVICE=${IO_DEVICE:-sda}         # block device under DATA_ROOT, sampled by iostat
SAMPLE_INTERVAL=${SAMPLE_INTERVAL:-1}
RESULTS_DIR=${RESULTS_DIR:-results}            # relative to the repo root
# perf stat on the PG backend during each measured query (counting mode, negligible overhead).
# Hardware events need root (perf_event_paranoid); set PERF_STAT=0 where perf is unavailable.
PERF_STAT=${PERF_STAT:-1}
# RAID controller write-back cache (~1 GiB) survives drop_caches and holds recently written data.
# Each experiment with cold runs first writes+deletes this much scratch data under DATA_ROOT/bench
# (0 disables), then waits for the controller to destage it. See src/tpch/cache.py.
DEVICE_CACHE_EVICT_GIB=${DEVICE_CACHE_EVICT_GIB:-2}
DEVICE_CACHE_SETTLE_S=${DEVICE_CACHE_SETTLE_S:-15}
PERF_EVENTS=${PERF_EVENTS:-task-clock,cycles,instructions,ref-cycles,cycles:u,instructions:u,context-switches,cpu-migrations,page-faults,major-faults}
