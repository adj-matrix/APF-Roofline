# Shared experiment configuration.
# Read by bash (`source config.env`) and by Python (via `bash -c 'source config.env; env'`).
# Every value can be overridden from the environment, e.g. `TPCH_SFS="1" src/setup/setup.sh data`.

# --- PostgreSQL ---------------------------------------------------------------
PG_MAJOR=${PG_MAJOR:-18}
PG_PORT=${PG_PORT:-5444}            # non-default port: never collides with a distro cluster

# --- Locations ----------------------------------------------------------------
# Must be on a local disk: /home is NFS on the lab servers and must not hold data.
DATA_ROOT=${DATA_ROOT:-/srv/tpch}
PGDATA=${PGDATA:-$DATA_ROOT/pgdata}
PGSOCK=${PGSOCK:-$DATA_ROOT/run}     # unix socket dir; TCP is disabled
TBL_DIR=${TBL_DIR:-$DATA_ROOT/tbl}  # dbgen output: $TBL_DIR/sf<N>/*.tbl*
# SF >= BIG_SF_MIN does not fit the root LV: its .tbl files and its database (tablespace tpch_big,
# also used for temp files of that database) live on the dedicated sdb volume.
BIG_ROOT=${BIG_ROOT:-/srv/tpch-sdb}
BIG_SF_MIN=${BIG_SF_MIN:-100}
PGBIN=${PGBIN:-/usr/lib/postgresql/$PG_MAJOR/bin}

# --- TPC-H data ---------------------------------------------------------------
TPCH_SFS=${TPCH_SFS:-"1 10"}        # scale factors to generate and load (SF100 later, on sdb)
GEN_JOBS=${GEN_JOBS:-8}             # parallel dbgen chunks for SF > 1
# COPY streams. 1 = one table at a time, its chunks in order, in one transaction with FREEZE
# (wal_level=minimal: no WAL; tuples frozen at load). SF1/SF10 were loaded with 8 parallel streams,
# which fragmented lineitem (report #1); it was rewritten with VACUUM FULL afterwards.
LOAD_JOBS=${LOAD_JOBS:-1}
DBGEN_REPO=${DBGEN_REPO:-https://github.com/gregrahn/tpch-kit}
DBGEN_COMMIT=${DBGEN_COMMIT:-852ad0a5ee31ebefeed884cea4188781dd9613a3}

# --- Measurement --------------------------------------------------------------
IO_DEVICE=${IO_DEVICE:-sda}         # block device under DATA_ROOT, sampled by iostat
BIG_IO_DEVICE=${BIG_IO_DEVICE:-sdb} # block device under BIG_ROOT (SF >= BIG_SF_MIN); same RAID controller
SAMPLE_INTERVAL=${SAMPLE_INTERVAL:-1}
RESULTS_DIR=${RESULTS_DIR:-results}            # relative to the repo root
# perf stat on the PG backend during each measured query (counting mode, negligible overhead).
# Hardware events need root (perf_event_paranoid); set PERF_STAT=0 where perf is unavailable.
PERF_STAT=${PERF_STAT:-1}
# perf stat prints the counts every PERF_INTERVAL_MS (0: totals only). The per-interval counts go into
# timeline.csv (cycles and on-CPU time per second: clock and user/kernel split per phase); their sum is the
# total, exactly as without -I.
PERF_INTERVAL_MS=${PERF_INTERVAL_MS:-1000}
# A sampling profile of the backend (perf record, cpu-clock, wall-clock timestamps) into <run>/perf.data,
# at this many samples per second; 0 (default): none. For diagnosis runs only (~1 % overhead, MBs per run).
PERF_RECORD_HZ=${PERF_RECORD_HZ:-0}
# RAID controller write-back cache (~1 GiB) survives drop_caches and holds recently written data.
# Each experiment with cold runs first writes+deletes this much scratch data under <root>/bench of each
# volume it reads (DATA_ROOT, and BIG_ROOT for SF >= BIG_SF_MIN)
# (0 disables), then waits for the controller to destage it. See src/tpch/cache.py.
DEVICE_CACHE_EVICT_GIB=${DEVICE_CACHE_EVICT_GIB:-2}
DEVICE_CACHE_SETTLE_S=${DEVICE_CACHE_SETTLE_S:-15}
# With the NMI watchdog on, 4 general counters are free per hyperthread: cycles, cycles:u and the two LLC
# events (instructions:u was dropped for LLC-* in Q3; more events would be multiplexed and scaled).
PERF_EVENTS=${PERF_EVENTS:-task-clock,cycles,instructions,ref-cycles,cycles:u,LLC-loads,LLC-load-misses,context-switches,cpu-migrations,page-faults,major-faults}

# --- System settings during measurements (src/tpch/sysconf.py) ------------------
# Changed when run/experiment/bench starts, restored when it ends (nothing stays changed).
#   watchdog: nmi_watchdog=0   timers: stop periodic jobs   pgnuma: postmaster under numactl on PG_NUMA_NODE
#   cpufreq: CPU_GOVERNOR + CPU_NO_TURBO (the baseline; `experiment --cpufreq` varies it per run)
# Stage 1 (SF1/SF10) ran with none of these (governor schedutil, turbo on). Empty = touch nothing.
SYSCONF=${SYSCONF:-"watchdog timers pgnuma cpufreq"}
CPU_GOVERNOR=${CPU_GOVERNOR:-schedutil}  # stage 1 baseline; stage 2 decided by the frequency experiment (plan §4.21)
CPU_NO_TURBO=${CPU_NO_TURBO:-0}          # 0 = turbo on (system default)
PG_NUMA_NODE=${PG_NUMA_NODE:-0}     # RAID controller's node (/sys/bus/pci/devices/0000:03:00.0/numa_node)
